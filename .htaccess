# Lissom — oppsett for webroten (public_html) hos Domene.no.

RewriteEngine On

# Én adresse, ikke to.
#
# www.lissom.no og lissom.no ville ellers vaert to nettsteder med samme
# innhold. Google velger da selv hvilken som teller, og lenker og
# besokstall deles paa to. Vi sender www til den uten.
#
# Den staar for HTTPS-regelen med vilje: http://www gaar da rett til
# https:// uten www i ett hopp, framfor to.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L,NE]

# Alltid HTTPS. Sertifikatet er gratis og ligger allerede i cPanel.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

# Forsida er nettsida, ikke en omvei til den.
#
# «/» ble servert av index.html, som er en meta-refresh videre til
# lissom-2108.html. Adressefeltet endte dermed paa filnavnet — det var det
# PageSpeed maalte, og det er den adressen som ville blitt delt og indeksert.
# En canonical som peker til «/» fra en side som selv heter noe annet, er
# akkurat det Google klager paa.
#
# Naa serveres nettsida direkte paa «/». Ingen omdirigering, ett hopp
# faerre, og adressen blir staaende slik den ble skrevet.
#
# Rekkefolgen er reserven, ikke veien: «/» tas av en egen omskriving lenger
# nede, som sender den til side.php. Blir mod_rewrite borte, er det denne
# lista som svarer — og da skal nettsida staa der som for.
DirectoryIndex lissom-2108.html index.html

# Tegnkoding.
#
# Nettsiden er UTF-8, og sier det selv i <meta charset>. Men en Content-Type-
# header fra serveren overstyrer meta-taggen. Sier Apache «iso-8859-1», leser
# nettleseren æ, ø og å feil — og et ødelagt tegn inne i en JavaScript-streng
# gir «Invalid or unexpected token», som er akkurat feilen vi fikk.
#
# GitHub Pages sender UTF-8 av seg selv. Apache maa faa beskjed.
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .htm .js .css .svg .json
    AddType "text/html; charset=UTF-8"              .html .htm
    AddType "application/javascript; charset=UTF-8" .js
    AddType "text/css; charset=UTF-8"               .css
    AddType "image/svg+xml"                          .svg
</IfModule>

<IfModule mod_headers.c>
    # HTTPS, ogsaa neste gang.
    #
    # Regelen over sender http til https, men foerste besok gaar likevel
    # ukryptert ett hopp. Med denne husker nettleseren i et aar at dette
    # nettstedet bare snakker https, og hopper rett dit. Sertifikatet
    # fornyes av cPanel; skulle det likevel falle ut, er nettstedet
    # utilgjengelig i den perioden — derfor uten includeSubDomains, saa en
    # subdomene-feil ikke tar hovedsida med seg.
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Siden trenger verken mikrofon, kamera eller posisjon.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Hva sida faar lov aa hente, og hvorfra.
    #
    # Et sikkerhetsskann 24. august ga 91 av 100. Alt annet var i orden;
    # dette var det ene som manglet. Uten regelen kan et skript som paa et
    # eller annet vis havner inn i sida — gjennom et felt noen har skrevet i,
    # et bilde, en lenke — laste ned mer kode utenfra og sende data ut.
    # Med den kan nettleseren bare hente fra oss selv og fra Google Analytics.
    #
    # «unsafe-eval» maa staa. Malmotoren i support.min.js bygger logikken med
    # «new Function»; uten den tegnes sida uten innhold — proevd, og den ble
    # tom. «unsafe-inline» maa staa av samme grunn: bade stil og skript
    # ligger i selve fila. Regelen stopper altsaa ikke alt, men den stopper
    # det som betyr mest: kode hentet fra en fremmed tjener, innhold i
    # <object>, en <base>-tagg som flytter alle lenker, et skjema som sender
    # til en annen adresse, og at sida legges i en ramme paa et annet
    # nettsted.
    #
    # Googletagmanager er besoksmaalingen, og bare den. Den lastes uansett
    # ikke for noen som ikke har sagt ja til maaling.
    #
    # Proevd av foer den ble lagt inn: alle elleve offentlige sider, alle
    # elleve adminskjermer, innlogging, handlekurv, kasse, innholdsredigering
    # og mobilforhandsvisningen — null brudd, null skriptfeil.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Komprimering.
#
# Nettsiden er én fil på nær 1 MB. Komprimert er den 193 kB — en femdel. Uten
# dette laster hver besøkende ned hele megabyten, hver gang, og på mobilnett
# er det forskjellen på en side som er der med én gang og en som henger.
#
# Bare tekst komprimeres. Bilder er komprimert fra før, og å pakke dem om
# gjør dem større, ikke mindre.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Mellomlagring i nettleseren.
#
# Nettsiden endres når vi legger ut en ny utgave, og da skal den nye komme
# fram med én gang — «no-cache» betyr ikke «ikke lagre», men «spør først».
# Nettleseren beholder fila og sender en liten forespørsel; er den uendret
# svarer serveren 304 uten innhold, og ingenting lastes ned på nytt.
#
# Bilder og skrifttyper får derimot ligge lenge. De byttes ikke ut.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Skript og stilark manglet regel og fikk dermed ingen — nettleseren
    # spurte om dem paa nytt ved hvert besok. De endres bare naar vi legger
    # ut en ny utgave, og da med nytt innhold; en uke er trygt, og
    # «must-revalidate» gjor at en endring likevel kommer fram med én gang
    # den er eldre enn det.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>
    # Ingen regel for .php her med vilje. API-et setter sine egne headere:
    # «no-store» der eieren nettopp har lagret noe, og sju dagers
    # mellomlagring paa api/bilde.php, som serverer medlemmenes bilder. En
    # regel her ville overstyrt begge — og bildene ville blitt lastet ned paa
    # nytt ved hvert sidebesok.
</IfModule>

# Bilder i webp til dem som kan lese det.
#
# Fotografiene er en tredjedel mindre i webp, og det er det tyngste paa
# sida. De ligger som «bilde.jpg.webp» ved siden av originalen, og Apache
# velger ut fra hva nettleseren sier den tar imot. Ingen adresse i koden
# endres, og bakgrunnsbilder i CSS faar det samme — de kan ikke bruke
# <picture>.
#
# «Vary: Accept» maa staa, ellers kan en mellomlagring servere webp til en
# nettleser som ikke leser det.
#
# Ett unntak: robotene som lager lenkeforhaandsvisninger.
#
# Facebook, LinkedIn, Slack, WhatsApp og de andre henter delingsbildet selv.
# Sier en av dem at den tar imot webp, faar den webp servert paa en adresse
# som slutter paa .jpg — og flere av dem viser da ikke bildet i det hele
# tatt. Symptomet er en forhaandsvisning med tittel og tekst, men tomt der
# bildet skulle vaert. Proevd her: samme adresse gir image/webp med
# «Accept: image/webp» og image/jpeg uten.
#
# De faar originalen. Det er ett bilde per deling, ikke noe som teller paa
# hvor fort sida laster.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} !(facebookexternalhit|facebookcatalog|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|Applebot|vkShare|Iframely|Embedly) [NC]
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$1.$2.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ /$1.$2.webp [T=image/webp,E=webp:1,L]
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# Sidekartet bygges av det som ligger ute.
#
# Kursene har hver sin adresse naa, og de kommer og gaar. En fil med faste
# adresser blir feil samme dagen noen glemmer aa redigere den, saa
# /sitemap.xml svares av PHP. Regelen maa staa for regelen under, som ellers
# ville servert den gamle fila fordi den finnes.
RewriteRule ^sitemap\.xml$ /api/sitemap.php [L]

# Nettsidefilene har sine egne adresser fordi de ligger som ekte filer. Begge
# er den samme sida som «/», og tre adresser med samme innhold er duplikater i
# soket — de stjeler fra hverandre. Her sendes de dit de hoerer hjemme.
#
# «-uten-admin» er utgaven uten adminpanelet, som side.php sender til alle som
# ikke er innlogget som admin. Den skal ingen komme til direkte.
#
# Regelen kan ikke lage en runddans: «/» treffer den ikke, og DirectoryIndex
# gjor oppslaget internt, uten en ny forespoersel.
RewriteRule ^lissom-2108(-uten-admin)?\.html$ / [R=301,L]

# Det samme for den ferdigtegnede toppen. Den er en bit av forsida — menylinja
# og heroen — som side.php limer inn i svaret. Alene er den ikke en side: uten
# <html> og <head> ville Google sett en stump med den samme teksten som
# forsida, paa sin egen adresse. Ingen skal komme dit direkte.
RewriteRule ^forside-topp\.html$ / [R=301,L]

# Ekte adresser: lissom.no/kurs, /medlemskap, /om-oss ...
#
# Nettsiden er én fil som bytter skjerm i nettleseren. Uten dette hadde alle
# sider hatt samme adresse — umulig å dele en lenke til et kurs, og usynlig
# for søkemotorer. Finnes ikke fila som etterspørres, serveres nettsiden, og
# den finner selv ut hvilken skjerm adressen peker på.
#
# Fila går om side.php, som setter tittel, beskrivelse, canonical og
# delingstekst for den enkelte adressen før svaret går ut. Før dette hadde
# alle adresser samme tittel og ingen canonical for alt som ikke kjører
# JavaScript — deling på Instagram og Facebook, Bing, og AI-assistentene.
# Går noe galt i side.php, sendes fila ut slik den er.
#
# Forsida har sin egen regel. Den treffer ikke den under: REQUEST_FILENAME
# for «/» er katalogen, og «!-d» slaar regelen av. Uten dette ville forsida
# vaert den ene sida som IKKE fikk sitt eget hode — og den er den viktigste
# av dem alle.
RewriteRule ^$ /side.php [L]

# Ekte filer, mapper og /api går uendret gjennom.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ /side.php [L]

# Skjulte filer og oppsettfiler skal ikke kunne lastes ned.
<FilesMatch "^\.|(\.(ya?ml|md|sql|json|lock|example\.php))$">
    Require all denied
</FilesMatch>

# ... men Vipps og andre må få hente det som ligger i .well-known.
<IfModule mod_alias.c>
    RedirectMatch 404 /\.(?!well-known)
</IfModule>

# Ingen ErrorDocument for 404 her.
#
# Tidligere sto det «ErrorDocument 404 /index.html». Det ga en lukket sløyfe:
# index.html videresender til nettsiden, så en manglende fil sendte brukeren
# tilbake til starten i stedet for å si fra. Symptomet var en side som lastet
# i ring, og den ekte feilen var usynlig.
#
# Apache sin egen 404 er stygg, men ærlig. Den erstattes med en pen side når
# nettstedet er ferdig — ikke med en som lyver om hva som skjedde.
