# Lissom — oppsett for webroten (public_html) hos Domene.no.

# Alltid HTTPS. Sertifikatet er gratis og ligger allerede i cPanel.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Tegnkoding.
#
# Nettsiden er UTF-8, og sier det selv i <meta charset>. Men en Content-Type-
# header fra serveren overstyrer meta-taggen. Sier Apache «iso-8859-1», leser
# nettleseren æ, ø og å feil — og et ødelagt tegn inne i en JavaScript-streng
# gir «Invalid or unexpected token», som er akkurat feilen vi fikk.
#
# GitHub Pages sender UTF-8 av seg selv. Apache maa faa beskjed.
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .htm .js .css .svg .json
    AddType "text/html; charset=UTF-8"              .html .htm
    AddType "application/javascript; charset=UTF-8" .js
    AddType "text/css; charset=UTF-8"               .css
    AddType "image/svg+xml"                          .svg
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Siden trenger verken mikrofon, kamera eller posisjon.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Komprimering.
#
# Nettsiden er én fil på nær 1 MB. Komprimert er den 193 kB — en femdel. Uten
# dette laster hver besøkende ned hele megabyten, hver gang, og på mobilnett
# er det forskjellen på en side som er der med én gang og en som henger.
#
# Bare tekst komprimeres. Bilder er komprimert fra før, og å pakke dem om
# gjør dem større, ikke mindre.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Mellomlagring i nettleseren.
#
# Nettsiden endres når vi legger ut en ny utgave, og da skal den nye komme
# fram med én gang — «no-cache» betyr ikke «ikke lagre», men «spør først».
# Nettleseren beholder fila og sender en liten forespørsel; er den uendret
# svarer serveren 304 uten innhold, og ingenting lastes ned på nytt.
#
# Bilder og skrifttyper får derimot ligge lenge. De byttes ikke ut.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Svar fra API-et skal aldri mellomlagres. Innholdet eieren nettopp
    # lagret ville ellers kommet tilbake i sin gamle utgave.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
</IfModule>

# Ekte adresser: lissom.no/kurs, /medlemskap, /om-oss ...
#
# Nettsiden er én fil som bytter skjerm i nettleseren. Uten dette hadde alle
# sider hatt samme adresse — umulig å dele en lenke til et kurs, og usynlig
# for søkemotorer. Finnes ikke fila som etterspørres, serveres nettsiden, og
# den finner selv ut hvilken skjerm adressen peker på.
#
# Ekte filer, mapper og /api går uendret gjennom.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ /lissom-2108.html [L]

# Skjulte filer og oppsettfiler skal ikke kunne lastes ned.
<FilesMatch "^\.|(\.(ya?ml|md|sql|json|lock|example\.php))$">
    Require all denied
</FilesMatch>

# ... men Vipps og andre må få hente det som ligger i .well-known.
<IfModule mod_alias.c>
    RedirectMatch 404 /\.(?!well-known)
</IfModule>

# Ingen ErrorDocument for 404 her.
#
# Tidligere sto det «ErrorDocument 404 /index.html». Det ga en lukket sløyfe:
# index.html videresender til nettsiden, så en manglende fil sendte brukeren
# tilbake til starten i stedet for å si fra. Symptomet var en side som lastet
# i ring, og den ekte feilen var usynlig.
#
# Apache sin egen 404 er stygg, men ærlig. Den erstattes med en pen side når
# nettstedet er ferdig — ikke med en som lyver om hva som skjedde.
