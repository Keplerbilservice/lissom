# Det nye admin (admin-ny.html). Modulene lastes med import og har ingen
# versjon i adressen, saa uka med mellomlagring fra rota (.js/.css) gjorde at
# nettleseren viste den gamle utgaven etter en publisering (eieren, 3. oktober
# 2026). Samme regel som nyadmin/.htaccess: «no-cache» betyr «spør først»,
# uendret fil svarer 304 uten innhold.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
