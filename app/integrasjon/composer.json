{
  "name": "kepler/system-integrasjon",
  "description": "PHP MCP/OAuth integration for existing Domene.no hosting",
  "type": "project",
  "require": {
    "php": "^8.2",
    "mcp/sdk": "0.8.1",
    "league/oauth2-server": "9.4.1",
    "nyholm/psr7": "1.8.2",
    "nyholm/psr7-server": "1.1.0"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": {"php": "8.3.0"}
