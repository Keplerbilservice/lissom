-- Fjerner testkurset fra 004 igjen.
--
-- Kjøres FØRST når testbetalingen er verifisert. Bookinger og betalinger blir
-- staaende: de er bokfoeringspliktige, og skal ikke slettes selv om de gjaldt
-- en krone. Kurset settes derfor til avlyst i stedet for aa slettes, slik at
-- fremmednoklene fra bookings fortsatt peker et sted.

UPDATE course_sessions cs
  JOIN courses c ON c.id = cs.course_id
   SET cs.status = 'avlyst'
 WHERE c.slug = 'testkurs';

UPDATE courses SET status = 'avlyst' WHERE slug = 'testkurs';
